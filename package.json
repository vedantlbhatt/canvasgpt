{
  "name": "canvasgpt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "node src/ingest.js",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-timeout=30000 \"test/*.test.js\"",
    "sync": "node -e \"import('./src/sync.js').then(async m=>{const{openDb}=await import('./src/db.js');await m.runSync(openDb())})\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.252",
    "better-sqlite3": "^12.0.0",
    "express": "^5.0.0",
    "zod": "^4.0.0"
  }
}