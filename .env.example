APP_PASSWORD=change-me
CANVAS_HOST=https://gatech.instructure.com
DB_PATH=./data/canvas.db
PORT=3000
# Optional. Local dev inherits your logged-in `claude` CLI auth automatically.
# For deploy: run `claude setup-token` and paste the result here.
# CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Bearer token for the /mcp connector endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave unset to keep /mcp disabled entirely.
MCP_TOKEN=
